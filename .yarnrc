# @teamimpact/veda-ui declares `engines: { node: ">=24" }`, and .nvmrc pins 24
# to match. Amplify's build image runs Node 22 and does not honour .nvmrc, so
# `yarn install` aborts with "The engine node is incompatible with this module".
# The app builds and runs correctly on Node 22, so skip the check for installs.
# Remove this once the Amplify build image is on Node 24.
--install.ignore-engines true
